---
import Layout from "../layouts/Layout.astro";
---
<Layout titulo="Únete a nuestro equipo" activo="">
  <div class="franja-foto franja-nosotros">
    <div class="franja-contenido">
      <h1>Únete a nuestro equipo</h1>
      <p>Llena el formulario y aplica a una entrevista para evaluar tus opciones de desarrollo con nosotros.</p>
    </div>
  </div>

  <section class="seccion">
    <div class="contenedor" style="max-width:640px">
      <form class="formulario" action="https://formspree.io/f/maenlpvn" method="POST" enctype="multipart/form-data">
        <div class="campo">
          <label for="nombre">Nombre</label>
          <input type="text" id="nombre" name="nombre" required />
        </div>
        <div class="campo">
          <label for="apellidos">Apellidos</label>
          <input type="text" id="apellidos" name="apellidos" required />
        </div>
        <div class="campo">
          <label for="telefono">Número de teléfono</label>
          <input type="tel" id="telefono" name="telefono" placeholder="55 1234 5678" />
        </div>
        <div class="campo">
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="campo">
          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
        </div>
        <div class="campo">
          <label for="cv">Añadir CV</label>
          <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" />
        </div>
        <div class="campo" style="display:flex; align-items:flex-start; gap:8px;">
          <input type="checkbox" id="privacidad" name="privacidad" required style="width:auto; margin-top:4px;" />
          <label for="privacidad" style="margin:0; font-weight:400;">He leído el Aviso de Privacidad</label>
        </div>
        <button type="submit" class="boton boton-oscuro" style="border:none; cursor:pointer; width:100%">Enviar</button>
      </form>
    </div>
  </section>
</Layout>
