---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const categorias = [
  { icono: "documento", titulo: "Administrativas", texto: "Garantizan el cumplimiento de obligaciones contractuales." },
  { icono: "confianza", titulo: "Fidelidad", texto: "Protegen ante actos deshonestos del personal de confianza." },
  { icono: "credito", titulo: "Crédito", texto: "Aseguran el cumplimiento de obligaciones de pago." },
  { icono: "fiscal", titulo: "Fiscales", texto: "Garantizan obligaciones ante autoridades fiscales." },
];
---
<Layout titulo="Fianzas" activo="fianzas">
  <div class="franja-foto franja-fianzas">
    <div class="franja-contenido">
      <h1>Fianzas</h1>
      <p>Garantía judicial que asegura el cumplimiento de una obligación, respaldando la confianza entre las partes.</p>
    </div>
  </div>

  <section class="seccion">
    <div class="contenedor">
      <div class="rejilla">
        {categorias.map((c) => (
          <div class="tarjeta">
            <div class="icono"><Icon nombre={c.icono} /></div>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:44px">
        <a href="/contacto" class="boton boton-oscuro">Obtener asesoría personalizada</a>
      </div>
    </div>
  </section>
</Layout>
