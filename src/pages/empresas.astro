---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const categorias = [
  { icono: "auto", titulo: "Seguro de Automóvil", texto: "Protege la flotilla vehicular de tu empresa." },
  { icono: "balanza", titulo: "Responsabilidad Civil", texto: "Cobertura ante reclamos de terceros por daños." },
  { icono: "barco", titulo: "Marítimo", texto: "Protección para carga y operaciones marítimas." },
  { icono: "camion", titulo: "Transporte", texto: "Resguarda tu mercancía durante todo el trayecto." },
  { icono: "fuego", titulo: "Incendio", texto: "Cobertura ante siniestros que afecten tus instalaciones." },
];
---
<Layout titulo="Empresas" activo="empresas">
  <div class="franja-foto franja-empresas">
    <div class="franja-contenido">
      <h1>Empresas</h1>
      <p>Los imprevistos no se pueden predecir. En Caballero Alva aseguramos el bienestar de tu empresa y empleados.</p>
    </div>
  </div>

  <section class="seccion">
    <div class="contenedor">
      <div class="rejilla">
        {categorias.map((c) => (
          <div class="tarjeta">
            <div class="icono"><Icon nombre={c.icono} /></div>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:44px">
        <a href="/contacto" class="boton boton-oscuro">Obtener asesoría personalizada</a>
      </div>
    </div>
  </section>
</Layout>
